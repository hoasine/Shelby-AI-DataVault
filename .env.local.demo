# =============================================================================
# Shelby AI DataVault — .env.local (git-ignored)
# =============================================================================
# Secrets and local overrides. Copy this file to .env.local and fill in values.
# .env.local is never committed — keep all secrets here.
# =============================================================================


# ── Network (Shelbynet) ───────────────────────────────────────────────────────

# Wallet + marketplace + blobs all use Shelbynet (chain ID 110).
NEXT_PUBLIC_APP_NETWORK=shelbynet

# Fullnode — defaults to https://api.shelbynet.shelby.xyz/v1 in code.
# NEXT_PUBLIC_APTOS_NODE_URL=https://api.shelbynet.shelby.xyz/v1

# Optional Geomi key for Shelbynet fullnode rate limits (not the Shelby blob key).
# NEXT_PUBLIC_APTOS_API_KEY=


# ── Deployed contract ──────────────────────────────────────────────────────────

# Redeploy on Shelbynet after migration: npm run move:publish
# Address written automatically by publish script.
NEXT_PUBLIC_MODULE_ADDRESS=0x...


# ── Deployer account ───────────────────────────────────────────────────────────

# Must hold APT on Shelbynet for gas (Shelby faucet / Geomi).
NEXT_MODULE_PUBLISHER_ACCOUNT_ADDRESS=0x...
NEXT_MODULE_PUBLISHER_ACCOUNT_PRIVATE_KEY=ed25519-priv-0x...

# Optional dedicated secret for download nonce HMAC.
# DOWNLOAD_AUTH_SECRET=change-me-to-a-long-random-string


# ── Shelby blob storage (Shelbynet) ────────────────────────────────────────────

# Geomi API key — server-side Shelby RPC bandwidth.
# Get from: https://geomi.dev → create project → API Resource → network: shelbynet
SHELBY_API_KEY=AG-...

NEXT_PUBLIC_SHELBY_API_KEY=AG-...

# Defaults to shelbynet-1 in code.
# SHELBY_LOCATION_HINT=shelbynet-1

# Origin for Shelbynet API (match dev port if not 3000).
NEXT_PUBLIC_APP_URL=http://localhost:3002
