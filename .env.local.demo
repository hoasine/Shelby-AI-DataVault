# =============================================================================
# Shelby AI DataVault — .env.local (git-ignored)
# =============================================================================
# Secrets and local overrides. Copy this file to .env.local and fill in values.
# .env.local is never committed — keep all secrets here.
# =============================================================================


# ── Aptos node (optional override) ────────────────────────────────────────────

# Defaults in code to https://fullnode.testnet.aptoslabs.com/v1
# NEXT_PUBLIC_APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com/v1


# ── Aptos API key ──────────────────────────────────────────────────────────────

# Aptos Labs / Geomi key for Aptos TESTNET only (not Shelbynet).
# Leave unset unless you have a valid testnet key — placeholders break the wallet.
# NEXT_PUBLIC_APTOS_API_KEY=


# ── Deployed contract ──────────────────────────────────────────────────────────

# Address of the deployed Move module. Written automatically by npm run move:publish.
NEXT_PUBLIC_MODULE_ADDRESS=0x...


# ── Deployer account (Aptos CLI only) ─────────────────────────────────────────

# Used by: npm run move:publish / move:upgrade
# Must hold APT on the target network for gas.
# Get your address: aptos config show-profiles  OR check your wallet.
NEXT_MODULE_PUBLISHER_ACCOUNT_ADDRESS=0x...
NEXT_MODULE_PUBLISHER_ACCOUNT_PRIVATE_KEY=ed25519-priv-0x...

# Optional dedicated secret for download nonce HMAC. Falls back to the publisher
# private key above when unset (already present on Vercel).
# DOWNLOAD_AUTH_SECRET=change-me-to-a-long-random-string


# ── Shelby blob storage (Shelbynet) ────────────────────────────────────────────

# Geomi API key — used server-side for Shelby RPC bandwidth.
# Get from: https://geomi.dev → create project → API Resource → network: shelbynet
SHELBY_API_KEY=AG-...

# Same key exposed to the browser if needed for client-side Shelby reads.
NEXT_PUBLIC_SHELBY_API_KEY=AG-...

# Region hint for blob writes (SDK 0.6+). Defaults to shelbynet-1 in code.
# SHELBY_LOCATION_HINT=shelbynet-1

# Origin header sent with server-side Shelby requests.
# Must match the domain your server runs on. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
